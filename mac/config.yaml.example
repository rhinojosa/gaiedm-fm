# Deep House Radio Configuration
# Copy this file to config.yaml and customize for your setup

# Music sources - directories containing audio files (mp3, flac, m4a, wav)
# Organize by show for automatic show assignment:
#   ~/Music/the_deep/        -> assigned to "The Deep"
#   ~/Music/frequencies/     -> assigned to "Frequencies"
#   ~/Music/anthem_hour/     -> assigned to "Anthem Hour"
# Or put everything in one dir — the scanner will use genre/BPM to sort
music_sources:
  - ~/Music
  - /path/to/more/music

# SoundCloud integration (optional, supplementary source)
soundcloud:
  # OAuth token (get from browser cookies on soundcloud.com)
  # Or store in ~/.writ/soundcloud_token
  # token: "your-oauth-token-here"
  enabled: true
  download_dir: output/soundcloud

# LLM settings (for Claude CLI DJ dialogue scripts)
llm:
  timeout: 60
  temperature: 0.8
  max_tokens: 300

# Kokoro TTS settings (for DJ voice)
tts:
  engine: kokoro    # kokoro or chatterbox
  # Chatterbox-specific (if using voice cloning):
  # voice_reference: ./voice_reference/dj_voice.wav
  # exaggeration: 0.5
  # cfg_weight: 0.5
  # temperature: 0.8

# Icecast streaming server
icecast:
  host: localhost
  port: 8000
  mount: /stream
  source_password: YOUR_SOURCE_PASSWORD  # Must match icecast.xml

# API server for now-playing info
api:
  port: 8001

# Content generation
generation:
  dj_segments_min: 6      # Keep this many DJ segments ready per show
  bumpers_min: 5           # Keep this many bumpers/jingles per show
